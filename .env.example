# ssorg.dev environment template.
# The app works WITHOUT a .env file. To change a setting, copy this file:
#     Copy-Item .env.example .env
# then remove the leading # from the lines you want and edit the values.
# Never put real secrets in .env.example, and never commit your real .env.
# (ssorg.dev needs no passwords or API keys.)

# Full path to tesseract.exe. Only needed if the app cannot find Tesseract by itself.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR language (default: eng). The language data must be installed in Tesseract.
# TESSERACT_LANG=eng

# Where Ollama is running. Default: http://localhost:11434
# Keep this on your own computer, otherwise your OCR text is sent to another machine.
# OLLAMA_HOST=http://localhost:11434

# The local model used for analysis. Default: gemma3:4b
# OLLAMA_MODEL=gemma3:4b

# Seconds to wait for the AI answer (default 120) and for OCR (default 60).
# OLLAMA_TIMEOUT=120
# OCR_TIMEOUT_SECONDS=60

# Where ssorg.dev keeps your library. Defaults are inside the project's "data" folder.
# Relative paths are relative to the project folder. Keep these OUT of Git.
# SSORG_DATA_DIR=data
# SSORG_SCREENSHOT_DIR=data/screenshots
# SSORG_DATABASE_PATH=data/ssorg.db